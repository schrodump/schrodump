generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EngineKind {
  postgres
  mysql
  mariadb
  mongodb
}

enum Role {
  admin
  operator
  viewer
}

// Ternary on purpose — there is no "OK". A backup whose restore was never observed is
// UNOBSERVED, never assumed good.
enum ArtifactState {
  VERIFIED
  UNOBSERVED
  FAILED
}

enum ExecutionMode {
  STREAM
  STAGED
}

enum VerifyLevel {
  NONE
  CHECKSUM
  FULL_RESTORE
}

enum CompressionAlgorithm {
  none
  zstd
  gzip
}

enum JobKind {
  BACKUP
  RESTORE
  VERIFY
  // Applies a policy's GFS retention. A job, not a background sweep: deleting a backup is an
  // outcome the operator has to be able to read afterwards — including when it refused to run.
  RETENTION
}

enum JobState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum KeyType {
  operational
  escrow
}

enum KeyState {
  active
  retired
}

enum DestinationSealMode {
  operational
  sealed
}

// ---------------------------------------------------------------------------
// Auth models (Better-Auth) — global, not organization-scoped. Users belong to
// organizations through Membership, so they carry no single organizationId.
// ---------------------------------------------------------------------------

model User {
  id                 String   @id
  name               String
  email              String   @unique
  emailVerified      Boolean  @default(false)
  image              String?
  // The bootstrap admin's password comes from env (visible in `docker inspect`), so it must
  // be rotated on first login.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  auditLogs   AuditLog[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Instance-global (pre-organization) models
// ---------------------------------------------------------------------------

model SetupToken {
  id         String    @id @default(cuid())
  // SHA-256 of the raw token; the raw token is never persisted.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Domain models — every one carries organizationId, no exception.
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Hidden in the UI while it is the only organization.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  databaseTargets      DatabaseTarget[]
  storageDestinations  StorageDestination[]
  backupPolicies       BackupPolicy[]
  backupJobs           BackupJob[]
  artifacts            Artifact[]
  encryptionKeys       EncryptionKey[]
  auditLogs            AuditLog[]
  notificationChannels NotificationChannel[]
  notificationStates   NotificationState[]
  notificationSnapshot NotificationSnapshot?
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model DatabaseTarget {
  id                  String     @id @default(cuid())
  organizationId      String
  name                String
  engine              EngineKind
  host                String
  port                Int
  username            String
  // Envelope-encrypted credential blob. Write-only from the user's perspective — never
  // decrypted for display.
  encryptedCredential Json
  tls                 Boolean    @default(true)
  scope               Json // { databases, schemas, collections }
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  backupPolicies BackupPolicy[]

  @@index([organizationId])
  @@index([organizationId, engine])
}

model StorageDestination {
  id                       String              @id @default(cuid())
  organizationId           String
  name                     String
  endpoint                 String?
  region                   String
  bucket                   String
  prefix                   String
  // The access key id is an identifier, not the secret; the secret is envelope-encrypted.
  accessKeyId              String
  encryptedSecretAccessKey Json
  forcePathStyle           Boolean             @default(false)
  // operational: server holds the identity (full verify). sealed: server holds only the
  // public recipient (verify degrades to checksum; restore needs an operator-supplied identity).
  sealMode                 DestinationSealMode @default(operational)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  backupPolicies BackupPolicy[]
  artifacts      Artifact[]

  @@index([organizationId])
}

model BackupPolicy {
  id                   String               @id @default(cuid())
  organizationId       String
  name                 String
  targetId             String
  destinationId        String
  cron                 String
  // GFS retention (see @schrodump/core RetentionPolicy).
  keepLast             Int                  @default(0)
  keepDaily            Int                  @default(0)
  keepWeekly           Int                  @default(0)
  keepMonthly          Int                  @default(0)
  keepYearly           Int                  @default(0)
  minAgeBeforeDeleteMs BigInt               @default(0)
  verifyLevel          VerifyLevel          @default(CHECKSUM)
  executionMode        ExecutionMode        @default(STREAM)
  parallelism          Int                  @default(1)
  compression          CompressionAlgorithm @default(zstd)
  enabled              Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  target       DatabaseTarget     @relation(fields: [targetId], references: [id])
  destination  StorageDestination @relation(fields: [destinationId], references: [id])
  jobs         BackupJob[]

  @@index([organizationId])
  @@index([organizationId, enabled])
}

model BackupJob {
  id             String    @id @default(cuid())
  organizationId String
  policyId       String?
  // The scheduling window; with policyId it forms the idempotency key so a duplicate trigger of
  // the same window does not create two jobs. Null for manual/ad-hoc jobs.
  scheduledAt    DateTime?
  kind           JobKind   @default(BACKUP)
  state          JobState  @default(PENDING)
  correlationId  String
  // The artifact a VERIFY/RESTORE job targets. Null for BACKUP jobs. Structural link so the
  // worker never parses correlationId.
  artifactId     String?
  // RESTORE-only: { target, confirmExistingDatabase, triggeredByUserId }. Null for BACKUP/VERIFY.
  restoreParams  Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  exitCode       Int?
  // Sanitized stderr from the runner — never raw client output.
  stderr         String?
  // Explicit reason for a FAILED/degraded outcome (e.g. orphaned by restart, sealed downgrade).
  reason         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy         BackupPolicy? @relation(fields: [policyId], references: [id])
  artifact       Artifact?     @relation("ProducedBy")
  verifyArtifact Artifact?     @relation("VerifyTarget", fields: [artifactId], references: [id])

  @@unique([policyId, scheduledAt])
  @@index([organizationId])
  @@index([organizationId, state])
}

// Where an organization's notifications go. One channel set per organization, deliberately: routing
// rules and per-user preferences are the kind of surface that turns a notifier into a config
// product, and the roadmap's stopgap was always "whatever monitoring you already run".
enum NotificationChannelKind {
  WEBHOOK
  SMTP
}

model NotificationChannel {
  id                    String                  @id @default(cuid())
  organizationId        String
  kind                  NotificationChannelKind @default(WEBHOOK)
  // WEBHOOK only.
  url                   String?
  // HMAC signing key, envelope-encrypted with the KEK like every other credential. A notification
  // crosses the trust boundary; nothing about it is exempt from the crypto rules.
  encryptedSecret       String?
  // SMTP only. The password is envelope-encrypted like every other credential; the rest is plain
  // configuration. Nullable columns with a discriminator rather than a table per kind — the shape
  // this schema already uses for a variant — and the domain type is discriminated so code cannot
  // read the wrong half.
  smtpHost              String?
  smtpPort              Int?
  smtpUsername          String?
  encryptedSmtpPassword String?
  fromAddress           String?
  toAddresses           String[]      @default([])
  enabled               Boolean                 @default(true)
  // Set when a delivery fails, so a notifier that cannot reach its channel is visible rather than
  // silently useless — which would be worse than having no notifications at all.
  lastFailureAt         DateTime?
  lastFailure           String?
  createdAt             DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// A condition currently reported as open. Notifications fire on TRANSITION, so this is what keeps a
// condition that stays true from being re-sent every tick until someone mutes the channel.
model NotificationState {
  id             String   @id @default(cuid())
  organizationId String
  trigger        String
  // Artifact id, policy id, or "" for a fleet-wide condition.
  key            String
  since          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, trigger, key])
  @@index([organizationId])
}

// The previous evaluation, which the "verification is falling behind" trigger compares against. One
// row per organization: the hysteresis needs exactly one prior point, not a history.
model NotificationSnapshot {
  organizationId String   @id
  at             DateTime
  unobserved     Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Artifact {
  id                  String               @id @default(cuid())
  organizationId      String
  jobId               String               @unique
  destinationId       String
  state               ArtifactState        @default(UNOBSERVED)
  bucketKey           String
  manifestKey         String
  engine              EngineKind
  executionMode       ExecutionMode        @default(STREAM)
  serverVersionNum    Int
  sizeRawBytes        BigInt
  sizeCompressedBytes BigInt
  checksumAlgorithm   String
  checksum            String
  compression         CompressionAlgorithm
  // Fingerprints of the recipients the artifact was encrypted for.
  keyIds              String[]
  // mongodb only: whether the archive was dumped with --oplog (i.e. from a replica set). NULL means
  // unknown — either a non-mongo engine, or an artifact written before the fact was tracked. Restore
  // needs it to decide whether --oplogReplay is safe; it cannot be re-derived later, because the
  // origin's topology may have changed or the origin may be gone.
  sourceHasOplog      Boolean?
  // jobIds this artifact depends on (full/incremental chain).
  dependsOn           String[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          BackupJob          @relation("ProducedBy", fields: [jobId], references: [id], onDelete: Cascade)
  destination  StorageDestination @relation(fields: [destinationId], references: [id])
  verifyJobs   BackupJob[]        @relation("VerifyTarget")

  @@index([organizationId])
  @@index([organizationId, state])
}

model EncryptionKey {
  id                String    @id @default(cuid())
  organizationId    String
  // Fingerprint of the public recipient.
  keyId             String
  type              KeyType
  // age recipient (public), e.g. age1...
  publicRecipient   String
  // Envelope-encrypted identity (secret) — present only for operational keys the server holds;
  // null for escrow keys (identity kept offline).
  encryptedIdentity Json?
  state             KeyState  @default(active)
  createdAt         DateTime  @default(now())
  retiredAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyId])
  @@index([organizationId])
  @@index([organizationId, type, state])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  // e.g. "restore.trigger", "credential.read" — restore and credential reads are mandatory.
  action         String
  targetType     String?
  targetId       String?
  correlationId  String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

// A dump of Schrodump's OWN metadata database. Instance-scoped, not organization-scoped: there is
// one metadata database per deployment regardless of how many organizations it holds.
//
// It is encrypted to the destination organization's recipients, and the ESCROW recipient is the one
// that matters. The operational key's identity is stored (KEK-wrapped) inside this very database —
// in the disaster this feature exists for, that identity is gone with it. Only the offline escrow
// identity can open a self-backup. Wiring refuses to run without an active escrow key rather than
// writing a decoy nobody can decrypt.
model SelfBackup {
  id             String          @id @default(cuid())
  state          SelfBackupState @default(RUNNING)
  // Which destination it was written to, and the organization whose keys sealed it. Kept as plain
  // strings, not relations: this row is forensic evidence and must survive the destination or the
  // organization being deleted. `organizationId` is null when the run failed before resolving the
  // destination at all — a misconfiguration has to be visible in the product, not only in a log.
  organizationId String?
  destinationId  String
  bucketKey      String?
  manifestKey    String?
  sizeBytes      BigInt?
  checksum       String?
  keyIds         String[]
  // Failure reason, already sanitized. Null while RUNNING and on success.
  reason         String?
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  @@index([startedAt])
}

enum SelfBackupState {
  RUNNING
  SUCCEEDED
  FAILED
}
