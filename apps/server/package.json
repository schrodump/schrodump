{
  "name": "@schrodump/server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@prisma/client": "^6.19.3",
    "@schrodump/core": "workspace:*",
    "@schrodump/engines": "workspace:*",
    "@schrodump/runner": "workspace:*",
    "@schrodump/storage": "workspace:*",
    "age-encryption": "^0.3.1",
    "better-auth": "^1.7.6",
    "cron-parser": "^5.10.1",
    "fastify": "^5.12.5",
    "nodemailer": "^9.1.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.3",
    "testcontainers": "^12.1.0"
  }
}
