# Schrodump — example environment.
# Copy to .env and fill in the values. NEVER commit your real .env.

# ---------------------------------------------------------------------------
# Secrets (required) — no defaults on purpose. Leave blank here; set in .env.
# ---------------------------------------------------------------------------

# Postgres password for the Schrodump metadata database.
# Used by both the app (DATABASE_URL) and the db service.
DB_PASSWORD=

# Key-encryption key (KEK). Generate with:  openssl rand -base64 32
#
# WARNING: the KEK encrypts the keys that protect every backup. If you LOSE this
# key you LOSE access to ALL encrypted backups — there is no recovery path.
# Store it OUTSIDE this host (a secrets manager / offline vault), not next to the
# data it protects.
SCHRODUMP_KEK=

# Initial admin. Leave BOTH lines commented out to create the first admin through the one-time
# setup link printed in the logs. Do not set them to an empty value: the server validates them as
# non-empty strings, so a blank value is an invalid value and it refuses to boot.
# Minimum 12 characters: the same floor the server enforces on every password. A shorter
# value fails the boot naming this variable, rather than provisioning a weak admin.
#SCHRODUMP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Non-secret settings — defaults shown; override only if needed.
# ---------------------------------------------------------------------------

# Public URL where Schrodump is reachable.
SCHRODUMP_URL=http://localhost:8080

# Initial admin email. See the note next to SCHRODUMP_ADMIN_PASSWORD above.
#SCHRODUMP_ADMIN_EMAIL=

# Host port to publish the web UI on.
PORT=8080

# Address the port is published on. Loopback by default: Schrodump speaks plain HTTP and
# authenticates with a session cookie, so reaching it across a network means putting a
# TLS-terminating reverse proxy in front. Set to 0.0.0.0 only if you understand that the
# cookie then crosses the network in clear. See docs/install.md.
PUBLISH_ADDR=127.0.0.1

# CIDRs of every hop in front of this server, comma-separated. Decides which address the
# login rate limit counts.
#
# Behind a reverse proxy, LEAVING THIS UNSET puts every client in one shared bucket: five
# bad passwords from one person then lock out everyone. With nothing in front, leaving it
# unset makes X-Forwarded-For attacker-controlled and the limit never fires. Set it.
#SCHRODUMP_TRUSTED_PROXIES=127.0.0.1/32

# Max bytes the local scratch volume may hold (default 100 GiB).
SCRATCH_MAX_BYTES=107374182400

# Max number of backups staged locally at the same time.
MAX_STAGED=2

# Docker network that ephemeral executors join to reach target databases.
EXECUTOR_NETWORK=schrodump_targets

# ---------------------------------------------------------------------------
# Self-backup — a dump of Schrodump's OWN metadata database.
# ---------------------------------------------------------------------------
# Without it, losing the metadata database means rebuilding the catalog from the
# manifests in the bucket. That works (Settings -> catalog rebuild), but it is a
# much longer day than restoring one dump.
#
# Set this to the id of an existing destination. Deliberately has no default: the
# metadata database holds every target's wrapped credential, so where it lands is
# a decision you make on purpose. Unset -> no self-backup, and the server says so
# in the logs at boot.
#
# REQUIRES AN ACTIVE ESCROW KEY. The operational key's identity is stored inside
# the very database being dumped, so only the offline escrow identity can open a
# self-backup after the disaster it exists for. Without one, the run fails with
# that reason rather than writing an artifact nobody could ever decrypt.
#SCHRODUMP_SELF_BACKUP_DESTINATION_ID=

# How often to take one, in milliseconds (default 24h). Measured from the last
# SUCCEEDED run, not from process start, so restarts do not reset the clock.
#SCHRODUMP_SELF_BACKUP_INTERVAL_MS=86400000

# Docker network the self-backup executor joins. This is NOT the executor network
# above: the metadata database sits on the internal network and is deliberately
# unreachable from the network that talks to your databases.
SELF_BACKUP_NETWORK=schrodump_internal

# ---------------------------------------------------------------------------
# Tuning — both are read by the server; leave unset to take its defaults.
# ---------------------------------------------------------------------------
# Dumps estimated above this size run STAGED. Read the note in docs/install.md
# before setting it: `parallelism > 1` on a policy is the explicit way in.
#SCHRODUMP_STAGED_THRESHOLD_BYTES=

# How old the previous notification snapshot must be before it anchors the
# "verification is falling behind" comparison (default 900000 = 15 min).
#SCHRODUMP_NOTIFY_MIN_GAP_MS=900000
