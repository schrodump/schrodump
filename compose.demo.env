# Schrodump — settings for the EVALUATION stack in compose.demo.yaml.
#
# THESE VALUES ARE PUBLIC. They are committed to a public repository, so everyone who has ever
# cloned Schrodump holds this stack's key-encryption key and every one of its passwords. A backup
# this stack writes is a backup any of them can open.
#
# That is deliberate: the point of the demo is that you type nothing to see a first VERIFIED
# backup. It is also the reason the demo must never hold data you would miss and must never be
# reachable from anything but the laptop it runs on.
#
# A real deployment starts from compose.yaml and .env.example, where you generate these yourself
# and keep the KEK somewhere other than the host it protects. See docs/install.md.

# The image the demo runs. `next` is the newest release, candidate or stable; compose.yaml's own
# default (`latest`) is only created by a STABLE release and Schrodump has not shipped one yet.
SCHRODUMP_IMAGE=schrodump/schrodump:next

# Not generated with `openssl rand -base64 32`, on purpose: it is the base64 of the ASCII string
# "schrodump-demo-kek-not-a-secret!", so nobody can mistake it for a key worth keeping.
SCHRODUMP_KEK=c2Nocm9kdW1wLWRlbW8ta2VrLW5vdC1hLXNlY3JldCE=

# Postgres password for Schrodump's own metadata database — not for the sample database, and not
# for anything you own.
DB_PASSWORD=schrodump-demo

# Loopback only, and the address the setup link is printed at. Sign-in is refused from any other
# origin, so open the UI at exactly this URL.
SCHRODUMP_URL=http://localhost:8080
PUBLISH_ADDR=127.0.0.1
PORT=8080

# Scratch holds dumps in CLEAR while a job runs, and is bind-mounted at the same absolute path on
# the host and in the container because the Docker daemon resolves the executors' bind sources on
# the host (see compose.yaml). Under /tmp so the teardown is one `rm -rf` and so Docker Desktop
# shares it without being reconfigured — which is also why this is not a path to use on a server.
SCRATCH_HOST_PATH=/tmp/schrodump-demo/scratch

# 2 GiB rather than the 100 GiB default: the demo's dumps are kilobytes, and /tmp is not a disk to
# fill.
SCRATCH_MAX_BYTES=2147483648

# The networks compose.demo.yaml creates. Both defaults assume the project is called `schrodump`;
# this one is called `schrodump-demo` so it can never adopt the volumes of a real deployment made
# from compose.yaml in the same clone.
EXECUTOR_NETWORK=schrodump-demo_targets
SELF_BACKUP_NETWORK=schrodump-demo_internal
